<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>rikuka.dev</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0a0a0a;
        --text: #f0f0f0;
        --muted: #888;
        --accent: #e8ff00;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        font-weight: 300;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .container {
        text-align: center;
      }

      .logo {
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
      }

      .message {
        margin-top: 1.5rem;
        font-size: 0.95rem;
        color: var(--muted);
        letter-spacing: 0.04em;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="logo">rikuka.dev</div>
      <p class="message">おもしろ同人バザール準備中</p>
    </div>
  </body>
</html>
