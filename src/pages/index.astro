---
import { getCollection } from 'astro:content';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/theme.css';
import { formatMonth, formatPublishedAt, getPublishedAt, monthKey } from '../lib/publish-date';

const posts = (await getCollection('blog'))
  .map((post) => {
    const publishedAt = getPublishedAt(post);
    return { post, publishedAt, month: monthKey(publishedAt) };
  })
  .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime());

// 絞り込み UI 用の一覧。タグは記事数の多い順、月は新しい順
const tagCounts = new Map<string, number>();
const monthCounts = new Map<string, number>();
for (const { post, month } of posts) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  monthCounts.set(month, (monthCounts.get(month) ?? 0) + 1);
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'));
const months = [...monthCounts.entries()].sort((a, b) => b[0].localeCompare(a[0]));
// 初期表示するタグ数。残りは「すべてのタグ」で開く
const VISIBLE_TAGS = 16;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeInit />
    <title>Blog — rikuka.dev</title>
    <Seo
      title="Blog — rikuka.dev"
      description="rikukaの個人テックブログ。AWS・認証認可・インフラ設計などの技術記事を書いています。"
      ogImage="/og.png"
    />
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        font-weight: 300;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 2.5rem;
        background: var(--header-bg);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .logo {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
        text-decoration: none;
      }

      .header-nav {
        display: flex;
        gap: 1.5rem;
      }

      .nav-link {
        font-size: 0.85rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.06em;
        transition: color 0.2s;
      }

      .nav-link:hover {
        color: var(--text);
      }

      .nav-link.active {
        color: var(--accent);
      }

      .posts {
        max-width: 960px;
        margin: 0 auto;
        padding: 3rem 2.5rem 4rem;
        display: flex;
        flex-direction: column;
      }

      .post-card {
        display: block;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
      }

      .post-list {
        border-top: 1px solid var(--border);
      }

      .post-card:hover .post-title {
        color: var(--accent);
      }

      .post-date {
        display: block;
        font-size: 0.75rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
      }

      .post-title {
        font-size: 1.15rem;
        font-weight: 400;
        line-height: 1.4;
        transition: color 0.2s;
      }

      .post-excerpt {
        margin-top: 0.4rem;
        font-size: 0.9rem;
        color: var(--muted);
        line-height: 1.6;
      }

      .post-tags {
        display: flex;
        gap: 0.4rem;
        margin-top: 0.6rem;
        flex-wrap: wrap;
      }

      .tag {
        font-size: 0.7rem;
        color: var(--accent);
        border: 1px solid var(--accent);
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        letter-spacing: 0.04em;
      }

      .empty-state {
        padding: 3rem 0;
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* 絞り込み。JS が無い環境では全件表示のまま隠しておく */
      .filters {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        padding-bottom: 1.5rem;
      }

      .filters[hidden] {
        display: none;
      }

      .filter-row {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .filter-label {
        font-size: 0.7rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        min-width: 3.2rem;
      }

      .filter-tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        flex: 1;
      }

      .filter-tag {
        font: inherit;
        font-size: 0.7rem;
        color: var(--accent);
        background: transparent;
        border: 1px solid var(--accent);
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
      }

      .filter-tag:hover {
        color: var(--text);
        border-color: var(--text);
      }

      .filter-tag[aria-pressed='true'],
      .filter-tag[aria-pressed='true']:hover {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--accent-contrast);
      }

      .filter-tag .count {
        opacity: 0.7;
        margin-left: 0.2em;
      }

      .filter-tag.more,
      .filter-tag.more:hover {
        border-style: dashed;
      }

      .filter-tags:not(.expanded) .filter-tag.overflow {
        display: none;
      }

      .filter-tags.expanded .filter-tag.more {
        display: none;
      }

      .filter-month {
        font: inherit;
        font-size: 0.8rem;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.3rem 0.6rem;
        cursor: pointer;
      }

      .filter-status {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        font-size: 0.8rem;
        color: var(--muted);
      }

      .filter-clear {
        font: inherit;
        font-size: 0.75rem;
        color: var(--accent);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .filter-clear[hidden] {
        display: none;
      }

      .post-card[hidden] {
        display: none;
      }

      .no-match {
        padding: 3rem 0;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .no-match[hidden] {
        display: none;
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 2rem 2.5rem;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo">rikuka.dev</a>
      <nav class="header-nav">
        <a href="/" class="nav-link active">Blog</a>
        <a href="/works" class="nav-link">Works</a>
        <ThemeToggle />
      </nav>
    </header>

    <section class="posts">
      {posts.length === 0 ? (
        <p class="empty-state">記事はまだありません。</p>
      ) : (
        <>
          <div class="filters" id="filters" hidden>
            <div class="filter-row">
              <span class="filter-label">Tag</span>
              <div class="filter-tags" id="filter-tags">
                {tags.map(([tag, count], i) => (
                  <button
                    type="button"
                    class:list={['filter-tag', { overflow: i >= VISIBLE_TAGS }]}
                    data-tag={tag}
                    aria-pressed="false"
                  >{tag}<span class="count">{count}</span></button>
                ))}
                {tags.length > VISIBLE_TAGS && (
                  <button type="button" class="filter-tag more" id="filter-tags-more">
                    すべてのタグ ({tags.length})
                  </button>
                )}
              </div>
            </div>
            <div class="filter-row">
              <label class="filter-label" for="filter-month">Month</label>
              <select class="filter-month" id="filter-month">
                <option value="">すべての月</option>
                {months.map(([key, count]) => (
                  <option value={key}>{formatMonth(key)} ({count})</option>
                ))}
              </select>
              <span class="filter-status">
                <span id="filter-count"></span>
                <button type="button" class="filter-clear" id="filter-clear" hidden>絞り込みを解除</button>
              </span>
            </div>
          </div>

          <div class="post-list" id="post-list">
            {posts.map(({ post, publishedAt, month }) => (
              <a
                href={`/blog/${post.id}`}
                class="post-card"
                data-tags={JSON.stringify(post.data.tags)}
                data-month={month}
              >
                <time class="post-date" datetime={publishedAt.toISOString()}>
                  {formatPublishedAt(publishedAt)}
                </time>
                <div class="post-title">{post.data.title}</div>
                <div class="post-excerpt">{post.data.description}</div>
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
          <p class="no-match" id="no-match" hidden>条件に合う記事はありません。</p>
        </>
      )}
    </section>

    <footer>&copy; rikuka.dev &mdash; All rights reserved &middot; <a href="/privacy" style="color: inherit;">プライバシーポリシー</a></footer>

    <script>
      // タグ・月の絞り込み。状態は URL の ?tag=&month= に持たせ、共有や戻る操作に耐えるようにする
      const filters = document.getElementById('filters');
      const tagList = document.getElementById('filter-tags');
      const monthSelect = document.getElementById('filter-month') as HTMLSelectElement | null;
      const countEl = document.getElementById('filter-count');
      const clearBtn = document.getElementById('filter-clear');
      const noMatch = document.getElementById('no-match');
      const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('#post-list .post-card'));

      if (filters && tagList && monthSelect && countEl && clearBtn && noMatch) {
        const tagButtons = Array.from(tagList.querySelectorAll<HTMLButtonElement>('.filter-tag[data-tag]'));
        const moreBtn = document.getElementById('filter-tags-more');
        const total = cards.length;

        const state = { tag: '', month: '' };

        function readUrl() {
          const params = new URLSearchParams(location.search);
          state.tag = params.get('tag') ?? '';
          state.month = params.get('month') ?? '';
        }

        function writeUrl() {
          const params = new URLSearchParams();
          if (state.tag) params.set('tag', state.tag);
          if (state.month) params.set('month', state.month);
          const qs = params.toString();
          history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
        }

        function apply() {
          let shown = 0;
          for (const card of cards) {
            const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
            const ok = (!state.tag || tags.includes(state.tag)) && (!state.month || card.dataset.month === state.month);
            card.hidden = !ok;
            if (ok) shown++;
          }
          for (const btn of tagButtons) {
            const active = btn.dataset.tag === state.tag;
            btn.setAttribute('aria-pressed', String(active));
            // 選択中のタグが折りたたみ側にあるときは開いて見せる
            if (active && btn.classList.contains('overflow')) tagList!.classList.add('expanded');
          }
          monthSelect!.value = state.month;
          const filtering = Boolean(state.tag || state.month);
          countEl!.textContent = filtering ? `${shown} / ${total} 件` : `${total} 件`;
          clearBtn!.hidden = !filtering;
          noMatch!.hidden = shown > 0;
        }

        for (const btn of tagButtons) {
          btn.addEventListener('click', () => {
            const tag = btn.dataset.tag ?? '';
            state.tag = state.tag === tag ? '' : tag;
            writeUrl();
            apply();
          });
        }

        moreBtn?.addEventListener('click', () => tagList.classList.add('expanded'));

        monthSelect.addEventListener('change', () => {
          state.month = monthSelect.value;
          writeUrl();
          apply();
        });

        clearBtn.addEventListener('click', () => {
          state.tag = '';
          state.month = '';
          writeUrl();
          apply();
        });

        window.addEventListener('popstate', () => {
          readUrl();
          apply();
        });

        readUrl();
        apply();
        filters.hidden = false;
      }
    </script>
  </body>
</html>
