---
import { getCollection, render } from 'astro:content';
import Analytics from '../../components/Analytics.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const rawBody = post.body ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{post.data.title} — rikuka.dev</title>
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0a0a0a;
        --surface: #111;
        --border: #222;
        --text: #f0f0f0;
        --muted: #888;
        --accent: #93928b;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        font-weight: 300;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 2.5rem;
        background: rgba(10,10,10,0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .logo {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
        text-decoration: none;
      }

      .header-nav {
        display: flex;
        gap: 1.5rem;
      }

      .nav-link {
        font-size: 0.85rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.06em;
        transition: color 0.2s;
      }

      .nav-link:hover {
        color: var(--text);
      }

      .nav-link.active {
        color: var(--accent);
      }

      .post-header {
        max-width: 960px;
        margin: 0 auto;
        padding: 4rem 2.5rem 2rem;
      }

      .post-date {
        font-size: 0.75rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.8rem;
      }

      .post-header h1 {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -0.01em;
      }

      .post-description {
        margin-top: 1rem;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.7;
      }

      .post-tags {
        display: flex;
        gap: 0.4rem;
        margin-top: 1rem;
        flex-wrap: wrap;
      }

      .tag {
        font-size: 0.7rem;
        color: var(--accent);
        border: 1px solid var(--accent);
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        letter-spacing: 0.04em;
      }

      .prose {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 2.5rem 4rem;
        line-height: 1.8;
        font-size: 1rem;
      }

      .prose :global(h2) {
        font-size: 1.5rem;
        font-weight: 400;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
      }

      .prose :global(h3) {
        font-size: 1.2rem;
        font-weight: 400;
        margin-top: 2rem;
        margin-bottom: 0.8rem;
      }

      .prose :global(p) {
        margin-bottom: 1.2rem;
      }

      .prose :global(strong) {
        font-weight: 600;
        color: var(--accent);
      }

      .prose :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .prose :global(ul), .prose :global(ol) {
        margin-bottom: 1.2rem;
        padding-left: 1.5rem;
      }

      .prose :global(li) {
        margin-bottom: 0.4rem;
      }

      .prose :global(blockquote) {
        border-left: 2px solid var(--accent);
        padding-left: 1rem;
        margin: 1.5rem 0;
        color: var(--muted);
        font-style: italic;
      }

      .prose :global(pre) {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1.2rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .prose :global(code) {
        font-family: 'SF Mono', 'Fira Code', monospace;
        font-size: 0.85em;
      }

      .prose :global(:not(pre) > code) {
        background: var(--surface);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        border: 1px solid var(--border);
      }

      .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }

      /* rehype-mermaid が生成する inline SVG。ダーク背景では既定テーマの
         文字が読めないため、明るい背景を敷く */
      .prose :global(svg[id^='mermaid']) {
        display: block;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1rem;
        margin: 1.5rem 0;
        box-sizing: border-box;
      }

      .back-link {
        display: block;
        max-width: 960px;
        margin: 0 auto;
        padding: 0 2.5rem;
        font-size: 0.85rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.04em;
        transition: color 0.2s;
      }

      .back-link:hover {
        color: var(--accent);
      }

      .copy-md-container {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 2.5rem 2rem;
        display: flex;
        justify-content: flex-end;
      }

      .copy-md-btn {
        font-family: 'Inter', sans-serif;
        font-size: 0.75rem;
        color: var(--muted);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.4rem 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
        letter-spacing: 0.04em;
      }

      .copy-md-btn:hover {
        color: var(--text);
        border-color: var(--accent);
      }

      .copy-md-btn.copied {
        color: var(--accent);
        border-color: var(--accent);
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 2rem 2.5rem;
        margin-top: 2rem;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo">rikuka.dev</a>
      <nav class="header-nav">
        <a href="/" class="nav-link active">Blog</a>
        <a href="/works" class="nav-link">Works</a>
      </nav>
    </header>

    <article>
      <div class="post-header">
        <div class="post-date">
          {post.data.date.toLocaleDateString('en-US', {
            year: 'numeric', month: 'short', day: 'numeric'
          })}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>

      <div class="prose">
        <Content />
      </div>

      <div class="copy-md-container">
        <button id="copy-md-btn" class="copy-md-btn">Copy as Markdown</button>
      </div>
      <textarea id="md-source" style="display:none">{rawBody}</textarea>
    </article>

    <a href="/" class="back-link">&larr; Back to all posts</a>

    <footer>&copy; rikuka.dev &mdash; All rights reserved</footer>

    <script>
      document.getElementById('copy-md-btn')?.addEventListener('click', async () => {
        const source = document.getElementById('md-source') as HTMLTextAreaElement;
        const btn = document.getElementById('copy-md-btn')!;
        if (!source) return;
        try {
          await navigator.clipboard.writeText(source.value);
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy as Markdown';
            btn.classList.remove('copied');
          }, 2000);
        } catch {
          source.style.display = 'block';
          source.select();
          document.execCommand('copy');
          source.style.display = 'none';
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy as Markdown';
            btn.classList.remove('copied');
          }, 2000);
        }
      });
    </script>
  </body>
</html>
