---
import { getCollection, render } from 'astro:content';
import Analytics from '../../components/Analytics.astro';
import Seo from '../../components/Seo.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import '../../styles/theme.css';
import { formatPublishedAt, getPublishedAt } from '../../lib/publish-date';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const rawBody = post.body ?? "";
const publishedAt = getPublishedAt(post);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeInit />
    <title>{post.data.title} — rikuka.dev</title>
    <Seo
      title={`${post.data.title} — rikuka.dev`}
      description={post.data.description}
      ogType="article"
      publishedDate={publishedAt}
      tags={post.data.tags}
      ogImage={`/blog/${post.id}/og.png`}
    />
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        font-weight: 300;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 2.5rem;
        background: var(--header-bg);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .logo {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
        text-decoration: none;
      }

      .header-nav {
        display: flex;
        gap: 1.5rem;
      }

      .nav-link {
        font-size: 0.85rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.06em;
        transition: color 0.2s;
      }

      .nav-link:hover {
        color: var(--text);
      }

      .nav-link.active {
        color: var(--accent);
      }

      .post-header {
        max-width: 960px;
        margin: 0 auto;
        padding: 4rem 2.5rem 2rem;
      }

      .post-date {
        display: block;
        font-size: 0.75rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.8rem;
      }

      .post-header h1 {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -0.01em;
      }

      .post-description {
        margin-top: 1rem;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.7;
      }

      .post-tags {
        display: flex;
        gap: 0.4rem;
        margin-top: 1rem;
        flex-wrap: wrap;
      }

      .tag {
        font-size: 0.7rem;
        color: var(--accent);
        border: 1px solid var(--accent);
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        letter-spacing: 0.04em;
        text-decoration: none;
        transition: color 0.15s, border-color 0.15s;
      }

      .tag:hover {
        color: var(--text);
        border-color: var(--text);
      }

      .prose {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 2.5rem 4rem;
        line-height: 1.8;
        font-size: 1rem;
      }

      .prose :global(h2) {
        font-size: 1.5rem;
        font-weight: 400;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
      }

      .prose :global(h3) {
        font-size: 1.2rem;
        font-weight: 400;
        margin-top: 2rem;
        margin-bottom: 0.8rem;
      }

      .prose :global(p) {
        margin-bottom: 1.2rem;
      }

      .prose :global(strong) {
        font-weight: 600;
        color: var(--accent);
      }

      .prose :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .prose :global(ul), .prose :global(ol) {
        margin-bottom: 1.2rem;
        padding-left: 1.5rem;
      }

      .prose :global(li) {
        margin-bottom: 0.4rem;
      }

      .prose :global(blockquote) {
        border-left: 2px solid var(--accent);
        padding-left: 1rem;
        margin: 1.5rem 0;
        color: var(--muted);
        font-style: italic;
      }

      .prose :global(pre) {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1.2rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .prose :global(code) {
        font-family: 'SF Mono', 'Fira Code', monospace;
        font-size: 0.85em;
      }

      .prose :global(:not(pre) > code) {
        background: var(--surface);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        border: 1px solid var(--border);
      }

      /* Shiki dual theme: defaultColor:false なので span の色は CSS 変数で当てる */
      .prose :global(.astro-code span) {
        color: var(--shiki-dark);
      }

      :root[data-theme='light'] .prose :global(.astro-code span) {
        color: var(--shiki-light);
      }

      /* コピー用スクリプトが pre を .code-block でラップする(JS 生成要素なので :global) */
      .prose :global(.code-block) {
        position: relative;
        margin-bottom: 1.5rem;
      }

      .prose :global(.code-block > pre) {
        margin-bottom: 0;
      }

      .prose :global(.code-block[data-language])::before {
        content: attr(data-language);
        position: absolute;
        top: 0.55rem;
        right: 4.2rem;
        font-family: 'SF Mono', 'Fira Code', monospace;
        font-size: 0.7rem;
        color: var(--muted);
        letter-spacing: 0.05em;
        user-select: none;
      }

      .prose :global(.code-copy) {
        position: absolute;
        top: 0.45rem;
        right: 0.6rem;
        font-family: 'SF Mono', 'Fira Code', monospace;
        font-size: 0.7rem;
        color: var(--muted);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.15rem 0.5rem;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.15s, color 0.15s, border-color 0.15s;
      }

      .prose :global(.code-block:hover .code-copy) {
        opacity: 1;
      }

      .prose :global(.code-copy:hover) {
        color: var(--text);
        border-color: var(--accent);
      }

      .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }

      /* rehype-mermaid が生成する inline SVG。ダーク背景では既定テーマの
         文字が読めないため、明るい背景を敷く */
      .prose :global(svg[id^='mermaid']) {
        display: block;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1rem;
        margin: 1.5rem 0;
        box-sizing: border-box;
      }

      .back-link {
        display: block;
        max-width: 960px;
        margin: 0 auto;
        padding: 0 2.5rem;
        font-size: 0.85rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.04em;
        transition: color 0.2s;
      }

      .back-link:hover {
        color: var(--accent);
      }

      .copy-md-container {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 2.5rem 2rem;
        display: flex;
        justify-content: flex-end;
      }

      .copy-md-btn {
        font-family: 'Inter', sans-serif;
        font-size: 0.75rem;
        color: var(--muted);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.4rem 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
        letter-spacing: 0.04em;
      }

      .copy-md-btn:hover {
        color: var(--text);
        border-color: var(--accent);
      }

      .copy-md-btn.copied {
        color: var(--accent);
        border-color: var(--accent);
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 2rem 2.5rem;
        margin-top: 2rem;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo">rikuka.dev</a>
      <nav class="header-nav">
        <a href="/" class="nav-link active">Blog</a>
        <a href="/works" class="nav-link">Works</a>
        <ThemeToggle />
      </nav>
    </header>

    <article>
      <div class="post-header">
        <time class="post-date" datetime={publishedAt.toISOString()}>
          {formatPublishedAt(publishedAt)}
        </time>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <a class="tag" href={`/?tag=${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      </div>

      <div class="prose">
        <Content />
      </div>

      <div class="copy-md-container">
        <button id="copy-md-btn" class="copy-md-btn">Copy as Markdown</button>
      </div>
      <textarea id="md-source" style="display:none">{rawBody}</textarea>
    </article>

    <a href="/" class="back-link">&larr; Back to all posts</a>

    <footer>&copy; rikuka.dev &mdash; All rights reserved &middot; <a href="/privacy" style="color: inherit;">プライバシーポリシー</a></footer>

    <script>
      document.getElementById('copy-md-btn')?.addEventListener('click', async () => {
        const source = document.getElementById('md-source') as HTMLTextAreaElement;
        const btn = document.getElementById('copy-md-btn')!;
        if (!source) return;
        try {
          await navigator.clipboard.writeText(source.value);
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy as Markdown';
            btn.classList.remove('copied');
          }, 2000);
        } catch {
          source.style.display = 'block';
          source.select();
          document.execCommand('copy');
          source.style.display = 'none';
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy as Markdown';
            btn.classList.remove('copied');
          }, 2000);
        }
      });
    </script>
    <script>
      document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code').forEach((pre) => {
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        const lang = pre.dataset.language;
        if (lang && lang !== 'plaintext') wrap.dataset.language = lang;
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const btn = document.createElement('button');
        btn.className = 'code-copy';
        btn.type = 'button';
        btn.textContent = 'copy';
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            btn.textContent = 'copied!';
            setTimeout(() => (btn.textContent = 'copy'), 1500);
          } catch {}
        });
        wrap.appendChild(btn);
      });
    </script>
  </body>
</html>
